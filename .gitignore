# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright e2e (saved sign-in sessions, traces, screenshots, report)
/e2e/.auth/
/e2e/.results/
/e2e/.report/
/playwright/.cache/
/.next-e2e/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# DocuSign credentials
private.key
*.key
generate-token.js

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/

/src/generated/prisma

# Cleanup files
node_modules_trash/
*.log
tsc_*.log
tsc_*.txt
*_output.txt
prisma_error*.log
test-prisma.ts

# generated NDA artifacts
/tmp/
/public/tmp/

# Claude Local Settings
.claude/settings.local.json
.claude/worktrees/

# Hallmark design audit records and screenshots
.hallmark/
